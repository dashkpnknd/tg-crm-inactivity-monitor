# Telegram application created at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The phone number of the account whose groups are monitored, in international format.
KSUSHA_PHONE=

# Token obtained from @BotFather. Never commit the real token.
BOT_TOKEN=

# Optional. Comma-separated Telegram user IDs allowed to control the bot.
# Leave empty for the first /setup; its author becomes the controller.
CONTROLLER_USER_IDS=

# Comma-separated Telegram user IDs of staff. Their messages do not count as client activity.
TEAM_USER_IDS=

INACTIVITY_DAYS=3
# Three-day inactivity does not need frequent polling. Keep this at 60 or higher.
CHECK_INTERVAL_MINUTES=60
DATABASE_PATH=data/crm_monitor.sqlite3
SESSION_PATH=data/ksusha
LOG_LEVEL=INFO
